# frozen_string_literal: true

require "yaml"

inventory_path = File.expand_path("../ansible/inventory/vagrant-lab.yml", __dir__)
inventory = YAML.safe_load(File.read(inventory_path), aliases: false)
all = inventory.fetch("all")
lab = all.fetch("vars").fetch("vagrant_lab")
hosts = all.fetch("hosts")
groups = all.fetch("children")
box = lab.fetch("box")
resources = lab.fetch("resources")
virtualbox = lab.fetch("virtualbox")
underlay = lab.fetch("underlay")
libvirt = lab.fetch("libvirt")
management_network = libvirt.fetch("management_network")
underlay_prefix_length = underlay.fetch("cidr").split("/", 2).fetch(1)
proxy_names = groups.fetch("proxy_nodes").fetch("hosts").keys
verifier_names = groups.fetch("verification_workers").fetch("hosts").keys

verifier_routes = proxy_names.flat_map do |proxy_name|
  proxy = hosts.fetch(proxy_name)
  proxy.fetch("proxy_listeners").map do |listener|
    ["#{listener.fetch("egressIp")}/32", proxy.fetch("wireguard_endpoint")]
  end
end

Vagrant.require_version ">= #{lab.fetch("minimum_vagrant_version")}"

Vagrant.configure("2") do |config|
  config.vm.box = box.fetch("name")
  config.vm.box_version = box.fetch("version")
  config.vm.box_architecture = box.fetch("architecture")
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |provider|
    provider.cpus = virtualbox.fetch("cpus")
    provider.memory = resources.fetch("memory_mb")
  end

  config.vm.provider "libvirt" do |provider|
    provider.uri = libvirt.fetch("uri")
    provider.cpus = resources.fetch("cpus")
    provider.memory = resources.fetch("memory_mb")
    provider.graphics_type = "none"
    provider.mgmt_attach = true
    provider.management_network_name = management_network.fetch("name")
    provider.management_network_address = management_network.fetch("address")
    provider.management_network_mode = management_network.fetch("mode")
    provider.management_network_keep = true
  end

  hosts.each do |machine_name, host|
    config.vm.define machine_name, primary: machine_name == lab.fetch("primary_machine") do |machine|
      machine.vm.hostname = machine_name
      machine.vm.network "private_network",
                         ip: host.fetch("wireguard_endpoint"),
                         netmask: underlay.fetch("netmask"),
                         virtualbox__intnet: underlay.fetch("name"),
                         libvirt__network_name: underlay.fetch("name"),
                         libvirt__host_ip: underlay.fetch("libvirt_host_ip"),
                         libvirt__forward_mode: "none",
                         libvirt__dhcp_enabled: false

      if proxy_names.include?(machine_name) || verifier_names.include?(machine_name)
        provisioner_arguments = [
          "configure",
          "--underlay-cidr",
          "#{host.fetch("wireguard_endpoint")}/#{underlay_prefix_length}",
          "--egress-interface",
          "lef-egress0"
        ]

        if proxy_names.include?(machine_name)
          host.fetch("proxy_listeners").each do |listener|
            provisioner_arguments.concat(["--egress-address", "#{listener.fetch("egressIp")}/32"])
          end
        else
          verifier_routes.each do |destination, via|
            provisioner_arguments.concat(["--return-route", destination, via])
          end
        end

        machine.vm.provision "guest-network",
                             type: "shell",
                             path: "provision/guest-network.sh",
                             args: provisioner_arguments,
                             privileged: true
      end
    end
  end
end
