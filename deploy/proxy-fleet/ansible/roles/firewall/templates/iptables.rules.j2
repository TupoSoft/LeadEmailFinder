{{ ansible_managed | comment }}
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -m comment --comment "proxy-fleet:loopback" -j ACCEPT
-A INPUT -m state --state ESTABLISHED,RELATED -m comment --comment "proxy-fleet:established" -j ACCEPT
-A INPUT -p tcp --dport 22 -m comment --comment "proxy-fleet:ssh" -j ACCEPT
-A INPUT -p udp --dport {{ proxy_fleet_wireguard_port }} -m comment --comment "proxy-fleet:wireguard" -j ACCEPT
{% if inventory_hostname in (groups['swarm_managers'] + groups['proxy_nodes']) %}
{% for peer_address in proxy_fleet_swarm_peer_addresses %}
-A INPUT -i wg0 -s {{ peer_address }}/32 -p tcp --dport {{ proxy_fleet_swarm_control_port }} -m comment --comment "proxy-fleet:swarm-control" -j ACCEPT
-A INPUT -i wg0 -s {{ peer_address }}/32 -p tcp --dport {{ proxy_fleet_swarm_data_tcp_port }} -m comment --comment "proxy-fleet:swarm-data-tcp" -j ACCEPT
-A INPUT -i wg0 -s {{ peer_address }}/32 -p udp --dport {{ proxy_fleet_swarm_data_udp_port }} -m comment --comment "proxy-fleet:swarm-data-udp" -j ACCEPT
-A INPUT -i wg0 -s {{ peer_address }}/32 -p udp --dport {{ proxy_fleet_swarm_vxlan_port }} -m comment --comment "proxy-fleet:swarm-vxlan" -j ACCEPT
{% endfor %}
{% endif %}
{% if inventory_hostname in groups['proxy_nodes'] %}
{% for worker_cidr in proxy_fleet_worker_cidrs %}
{% for listener in proxy_listeners %}
-A INPUT -i wg0 -s {{ worker_cidr }} -p tcp --dport {{ listener.port }} -m comment --comment "proxy-fleet:listener-{{ listener.egressId }}" -j ACCEPT
{% endfor %}
{% endfor %}
{% endif %}
COMMIT
