{
    "private": true,
    "name": "@kk/email-verifier",
    "version": "1.2.0",
    "description": "Email Verifier",
    "scripts": {
        "build": "tsc",
        "clean": "tsc --build --clean && rm -r dist",
        "start:debug": "node --trace-sync-io --trace-warnings --inspect=0.0.0.0:9229 -r ts-node/register src/index.ts",
        "start:dev": "node --trace-sync-io --trace-warnings -r ts-node/register src/index.ts",
        "start:prod": "node dist/index.js",
        "test": "glob -c \"node -r ts-node/register --test\" src/**/*.test.ts",
        "test:debug": "glob -c \"node -r ts-node/register --inspect=0.0.0.0:9229 --test\" src/**/*.test.ts"
    },
    "keywords": [
        "email",
        "verifier",
        "verification",
        "SMTP"
    ],
    "author": "Kyrylo Kupin",
    "license": "UNLICENSED",
    "devDependencies": {
        "@eslint/js": "^9.11.0",
        "@tsconfig/recommended": "^1.0.7",
        "@types/eslint__js": "^8.42.3",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.13",
        "@types/node": "^22.5.5",
        "eslint": "^8.57.1",
        "eslint-config-love": "^62.0.1",
        "glob": "^11.0.0",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.2",
        "typescript-eslint": "^8.6.0"
    },
    "dependencies": {
        "axios": "^1.7.7",
        "express": "^4.21.0",
        "express-validator": "^7.2.0",
        "ip-address": "^9.0.5",
        "mongodb": "^6.9.0"
    }
}
