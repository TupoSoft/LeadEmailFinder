{
    "private": true,
    "name": "@kk/email-verifier-project",
    "version": "1.0.0",
    "description": "Email Verifier",
    "scripts": {
        "build": "tsc",
        "clean": "tsc --build --clean && rm -r dist",
        "start:debug": "node --trace-sync-io --trace-warnings --inspect=0.0.0.0:9229 -r ts-node/register packages/email-verifier/source/index.ts",
        "start:dev": "node --trace-sync-io --trace-warnings -r ts-node/register packages/email-verifier/source/index.ts",
        "start:prod": "pnpm --filter email-verifier start:prod",
        "lint": "ts-standard",
        "lint:fix": "ts-standard --fix",
        "test": "jest"
    },
    "keywords": [
        "email",
        "verifier",
        "verification",
        "SMTP"
    ],
    "author": "Kyrylo Kupin",
    "license": "UNLICENSED",
    "devDependencies": {
        "@eslint/js": "^9.9.1",
        "@tsconfig/recommended": "^1.0.7",
        "@types/eslint__js": "^8.42.3",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.5.4",
        "eslint": "^8.57.0",
        "eslint-config-love": "^62.0.1",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.5.4",
        "typescript-eslint": "^8.4.0"
    },
    "dependencies": {
        "ioredis": "^5.4.1",
        "ip-address": "^9.0.5",
        "mongoose": "^8.6.1"
    }
}
