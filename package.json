{
    "private": true,
    "name": "@tuposoft/lead-email-finder",
    "version": "0.10.0",
    "description": "Lead Email Finder API",
    "packageManager": "pnpm@10.11.1",
    "scripts": {
        "build": "nest build -p tsconfig.prod.json",
        "start": "node --env-file-if-exists=.env dist/main",
        "dev": "node --env-file-if-exists=.env --trace-sync-io --trace-warnings -r ts-node/register src",
        "debug": "node --env-file-if-exists=.env --trace-sync-io --trace-warnings --inspect=0.0.0.0:9229 -r ts-node/register src",
        "clean": "tsc --build --clean && rm -r dist",
        "test": "jest",
        "start:dev": "nest start -p tsconfig.dev.json -w",
        "start:debug": "nest start -p tsconfig.dev.json -w -d 0.0.0.0:9229"
    },
    "author": {
        "url": "https://tuposoft.com",
        "email": "contact@tuposoft.com",
        "name": "TupoSoft"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.25.0",
        "@jest/globals": "^29.7.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.11.22",
        "@tsconfig/node-lts": "^22.0.1",
        "@types/eslint__js": "^8.42.3",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.14",
        "@types/jest-when": "^3.5.5",
        "@types/multer": "^1.4.12",
        "@types/multer-s3": "^3.0.3",
        "@types/node": "^22.14.1",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^9.25.0",
        "eslint-config-love": "^114.0.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "glob": "^11.0.1",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.5.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.0",
        "swc-loader": "^0.2.6",
        "ts-jest": "^29.3.2",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.20.0"
    },
    "dependencies": {
        "@automapper/classes": "^8.8.1",
        "@automapper/core": "^8.8.1",
        "@automapper/nestjs": "^8.8.1",
        "@aws-sdk/client-s3": "^3.825.0",
        "@aws-sdk/lib-storage": "^3.825.0",
        "@nestjs/axios": "^4.0.0",
        "@nestjs/bullmq": "^11.0.2",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/mongoose": "^11.0.3",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.1.6",
        "@nestjs/terminus": "^11.0.0",
        "axios": "^1.8.4",
        "bullmq": "^5.49.1",
        "cheerio": "^1.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "csv-parse": "^5.6.0",
        "csv-stringify": "^6.5.2",
        "express": "^4.21.2",
        "express-validator": "^7.2.1",
        "ioredis": "^5.6.1",
        "jest-when": "^3.7.0",
        "mongodb": "^6.15.0",
        "mongoose": "^8.14.1",
        "multer-s3": "^3.0.1",
        "nestjs-s3": "^2.0.1",
        "pino": "^9.6.0",
        "pino-gelf": "^2.2.0",
        "pino-http": "^10.4.0",
        "pino-nestjs": "^0.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "swagger-ui-express": "^5.0.1",
        "tldts": "^6.1.86",
        "zod": "^3.24.3",
        "zod-openapi": "^4.2.4"
    },
    "pnpm": {
        "overrides": {
            "@automapper/classes>reflect-metadata": "$reflect-metadata",
            "@automapper/nestjs>@nestjs/common": "$@nestjs/common",
            "@automapper/nestjs>@nestjs/core": "$@nestjs/core"
        },
        "onlyBuiltDependencies": [
            "@nestjs/core",
            "@scarf/scarf",
            "@swc/core",
            "msgpackr-extract"
        ]
    }
}
