        "@jest/globals": "^29.7.0",
        "@tsconfig/node-lts": "^22.0.1",
        "@types/eslint__js": "^8.42.3",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.5",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.17.0",
        "eslint-config-love": "^114.0.0",
        "glob": "^11.0.0",
        "jest": "^29.7.0",
        "pnpm": "^9.15.2",
        "prettier": "^3.4.2",
