{
    "private": true,
    "name": "@tuposoft/lead-email-finder",
    "version": "0.10.0",
    "license": "Apache-2.0",
    "description": "Lead Email Finder workspace",
    "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
    "engines": {
        "node": "26.x"
    },
    "scripts": {
        "build:contracts": "pnpm --filter @tuposoft/lead-email-finder-verification-contracts build",
        "prebuild": "pnpm run build:contracts",
        "build": "pnpm --filter @tuposoft/lead-email-finder-api build && pnpm --filter @tuposoft/lead-email-finder-worker build",
        "prestart": "pnpm run build:contracts",
        "start": "pnpm --filter @tuposoft/lead-email-finder-api start",
        "prestart:worker": "pnpm run build:contracts",
        "start:worker": "pnpm --filter @tuposoft/lead-email-finder-worker start",
        "predebug": "pnpm run build:contracts",
        "debug": "pnpm --filter @tuposoft/lead-email-finder-api debug",
        "pretest": "pnpm run build:contracts",
        "test": "jest",
        "pretest:ci": "pnpm run build:contracts",
        "test:ci": "jest --runInBand",
        "prelint": "pnpm run build:contracts && pnpm --filter @tuposoft/lead-email-finder-api exec wrangler types",
        "lint": "eslint .",
        "pretypecheck": "pnpm run build:contracts",
        "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @tuposoft/lead-email-finder-api typecheck && tsc --noEmit -p apps/mcp-server/tsconfig.json && pnpm --filter @tuposoft/lead-email-finder-worker typecheck",
        "prepare": "husky || true",
        "dev": "pnpm --filter @tuposoft/lead-email-finder-api dev",
        "db:sync": "pnpm --filter @tuposoft/lead-email-finder-api db:sync",
        "db:reset": "pnpm --filter @tuposoft/lead-email-finder-api db:reset"
    },
    "author": {
        "url": "https://tuposoft.com",
        "email": "contact@tuposoft.com",
        "name": "TupoSoft"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.6.0",
        "@swc/core": "^1.16.22",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "@types/jest-when": "^3.5.5",
        "@types/node": "^26.6.6",
        "@types/supertest": "^7.2.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@usebruno/cli": "4.3.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-when": "^4.0.3",
        "openapi-typescript": "7.13.0",
        "pnpm": "12.18.0",
        "prettier": "^3.9.10",
        "supertest": "^7.3.2",
        "ts-node": "^10.9.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.1"
    }
}
