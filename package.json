{
    "private": true,
    "name": "@tuposoft/lead-email-finder",
    "version": "0.3.0",
    "description": "Lead Email Finder",
    "scripts": {
        "build": "tsc",
        "start": "node dist",
        "dev": "node --loader ts-node/esm --trace-sync-io --trace-warnings -r ts-node/register src",
        "debug": "node --trace-sync-io --trace-warnings --inspect=0.0.0.0:9229 -r ts-node/register src",
        "clean": "tsc --build --clean && rm -r dist",
        "test": "jest"
    },
    "keywords": [
        "lead",
        "email",
        "verifier",
        "finder",
        "verification",
        "SMTP"
    ],
    "author": "Kyrylo Kupin",
    "license": "UNLICENSED",
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@jest/globals": "^29.7.0",
        "@tsconfig/node22": "^22.0.0",
        "@types/eslint__js": "^8.42.3",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.1",
        "eslint": "^9.16.0",
        "eslint-config-love": "^110.0.0",
        "glob": "^11.0.0",
        "jest": "^29.7.0",
        "pnpm": "^9.14.4",
        "prettier": "^3.4.1",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.16.0"
    },
    "dependencies": {
        "@types/supertest": "^6.0.2",
        "axios": "^1.7.8",
        "bullmq": "^5.34.6",
        "cheerio": "^1.0.0",
        "dotenv": "^16.4.7",
        "express": "^4.21.1",
        "express-validator": "^7.2.0",
        "ioredis": "^5.4.1",
        "ip-address": "^9.0.5",
        "mongodb": "^6.11.0",
        "pino": "^9.5.0",
        "pino-gelf": "^2.2.0",
        "pino-http": "^10.3.0",
        "tldts": "^6.1.65",
        "zod": "^3.24.1"
