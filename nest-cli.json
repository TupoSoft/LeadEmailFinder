{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/tuposoft-lead-email-finder/src",
  "compilerOptions": {
    "builder": "webpack",
    "manualRestart": true,
    "deleteOutDir": true,
    "plugins": [
      "@nestjs/swagger"
    ],
    "tsConfigPath": "apps/tuposoft-lead-email-finder/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/tuposoft-lead-email-finder",
  "projects": {
    "async-email-verification-worker": {
      "type": "application",
      "root": "apps/async-email-verification-worker",
      "entryFile": "main",
      "sourceRoot": "apps/async-email-verification-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/async-email-verification-worker/tsconfig.app.json"
      }
    },
    "tuposoft-lead-email-finder": {
      "type": "application",
      "root": "apps/tuposoft-lead-email-finder",
      "entryFile": "main",
      "sourceRoot": "apps/tuposoft-lead-email-finder/src",
      "compilerOptions": {
        "tsConfigPath": "apps/tuposoft-lead-email-finder/tsconfig.app.json"
      }
    }
  }
}
