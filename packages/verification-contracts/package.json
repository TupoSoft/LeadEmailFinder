{
    "name": "@tuposoft/lead-email-finder-verification-contracts",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./queues": {
            "types": "./dist/queues.d.ts",
            "default": "./dist/queues.js"
        }
    },
    "typesVersions": {
        "*": {
            "queues": [
                "dist/queues.d.ts"
            ]
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@types/node": "^22.18.0",
        "typescript": "^5.9.2"
    }
}
