    "/v1/auth/callback": {
      "get": {
        "description": "Consumes one pending Authorization Code with PKCE response. Success returns to the validated pending /app destination; recoverable failures return to the same-origin error route with a stable safe code.",
        "operationId": "completeBrowserAuthorization",
        "parameters": [
          {
            "description": "One-time login state. Missing, blank, repeated, expired, or mismatched values fail safely.",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Provider authorization code. Missing, blank, or repeated values follow the safe redirect policy.",
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the validated pending /app destination after success, or to /auth/error with code login_state_invalid, authorization_code_exchange_failed, or active_membership_required.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents storage of the authorization response.",
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "Location": {
                "description": "Same-origin application or stable callback-error URL.",
                "schema": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "Referrer-Policy": {
                "description": "Prevents callback parameters from being sent as referrer data.",
                "schema": {
                  "enum": [
                    "no-referrer"
                  ],
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Expires the transient login-state cookie. A successful callback also sets the session and CSRF cookies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected provider, infrastructure, or application failure occurred without exposing detail.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents storage of the authorization response.",
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "Referrer-Policy": {
                "description": "Prevents callback parameters from being sent as referrer data.",
                "schema": {
                  "enum": [
                    "no-referrer"
                  ],
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Expires the transient login-state cookie. A successful callback also sets the session and CSRF cookies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "description": "The provider ID token failed integrity or claim validation. The response contains no provider detail.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents storage of the authorization response.",
                "schema": {
                  "enum": [
                    "no-store"
                  ],
                  "type": "string"
                }
              },
              "Referrer-Policy": {
                "description": "Prevents callback parameters from being sent as referrer data.",
                "schema": {
                  "enum": [
                    "no-referrer"
                  ],
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Expires the transient login-state cookie. A successful callback also sets the session and CSRF cookies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Complete browser authorization",
        "tags": [
          "BffSession"
        ],
        "x-callback-error-codes": [
          "login_state_invalid",
          "authorization_code_exchange_failed",
          "active_membership_required"
        ]
      }
    },
    "/v1/auth/login": {
      "get": {
        "operationId": "loginBrowserSession",
        "parameters": [
          {
            "description": "Relative application destination under /app. Unsafe, malformed, public, or recovery paths fall back to /app.",
            "in": "query",
            "name": "destination",
            "required": false,
            "schema": {
              "example": "/app/verification?view=recent",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the public Keycloak authorization endpoint with a PKCE S256 challenge.",
            "headers": {
              "Location": {
                "description": "Provider authorization URL.",
                "schema": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Sets the transient HttpOnly lef_login_state cookie and clears unusable session and CSRF cookies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Start browser authorization",
        "tags": [
          "BffSession"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Revokes the session and clears its cookies. Cookie-authenticated requests require a matching application Origin (or Referer) and the decoded lef_csrf_token cookie value in x-csrf-token.",
        "operationId": "logoutBrowserSession",
        "parameters": [
          {
            "description": "Fallback URL for checking the application origin when Origin is absent.",
            "in": "header",
            "name": "Referer",
            "required": false,
            "schema": {
              "format": "uri",
              "type": "string"
            }
          },
          {
            "description": "Must match the application origin. A same-origin Referer is accepted when Origin is absent.",
            "in": "header",
            "name": "Origin",
            "required": false,
            "schema": {
              "format": "uri",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The session is revoked; the lef_session and lef_csrf_token cookies are cleared.",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the session and CSRF cookies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationRequiredResponseDto"
                }
              }
            },
            "description": "Authentication is missing, invalid, or expired."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "enum": [
                        "Forbidden"
                      ],
                      "type": "string"
                    },
                    "message": {
                      "enum": [
                        "Request origin is not allowed",
                        "CSRF token is missing or invalid"
                      ],
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        403
                      ],
                      "type": "integer"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message",
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The cookie-authenticated request has a missing or invalid Origin, Referer, or CSRF token."
          }
        },
        "security": [
          {
            "lef_session": [],
            "x-csrf-token": []
          }
        ],
        "summary": "End the browser session",
        "tags": [
          "BffSession"
        ]
      }
    },
    "/v1/auth/session": {
      "get": {
        "description": "Returns browser-safe identity, membership, organization, capability, and service-client grant data for an authenticated human session.",
        "operationId": "getCurrentAccount",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentAccountContextDto"
                }
              }
            },
            "description": "Current browser account context."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationRequiredResponseDto"
                }
              }
            },
            "description": "Authentication is missing, invalid, expired, or no longer maps to a usable account."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanSessionRequiredResponseDto"
                }
              }
            },
            "description": "The authenticated credential is a service client rather than a human session."
          }
        },
        "security": [
          {
            "lef_session": []
          }
        ],
        "summary": "Read the current browser account",
        "tags": [
          "BffSession"
        ]
      }
    },
    "/v1/billing/summary": {
      "get": {
        "operationId": "BillingSummaryController_getSummary",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingSummaryResponseDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Authentication is required"
          },
          "403": {
            "description": "Billing read permission is required"
          }
        },
        "security": [
          {
            "lef_session": []
          },
          {
            "oidc": []
          }
        ],
        "summary": "",
        "tags": [
          "Billing"
        ]
      }
    },
    "/v1/email-verifications": {
      "post": {
        "description": "Admits one email for the authenticated organization through the durable admission stack. A fresh, uncached submission reserves one credit; a cached or shared result costs nothing. An optional canonical lowercase UUIDv7 Idempotency-Key header lets a caller safely retry an uncertain submission. Browser sessions require same-origin mutation protection.",
        "operationId": "AsyncEmailVerificationController_verifyAsync",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyAsyncRequestBodyDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyAsyncResponseDto"
                }
              }
            },
            "description": "The operation was admitted without waiting for verification. Follow Location to read status and result.",
            "headers": {
              "Location": {
                "description": "The admitted verification resource.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "error": "Bad Request",
                    "message": "invalid_idempotency_key",
                    "statusCode": 400
                  },
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        400
                      ],
                      "type": "integer"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The email is missing/invalid, or the Idempotency-Key header is malformed or repeated."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "code": "authentication_required"
                  },
                  "properties": {
                    "code": {
                      "enum": [
                        "authentication_required"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Authentication is required."
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "insufficient_credits",
                    "statusCode": 402
                  },
                  "properties": {
                    "message": {
                      "enum": [
                        "insufficient_credits"
                      ],
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        402
                      ],
                      "type": "integer"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The organization has insufficient credits; no execution was funded."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "error": "Forbidden",
                    "message": "Missing required permission",
                    "statusCode": 403
                  },
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "example": 403,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The required verification permission or browser mutation protection is missing."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "idempotency_key_conflict",
                    "statusCode": 409
                  },
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        409
                      ],
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The supplied Idempotency-Key was already used for a different address or delivery mode."
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "idempotency_key_expired",
                    "statusCode": 410
                  },
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        410
                      ],
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The supplied Idempotency-Key is more than 24 hours old."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "rate_limited",
                    "statusCode": 429
                  },
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        429
                      ],
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The organization submission rate limit, or a per-address terminal-inconclusive cooldown, was exceeded."
          }
        },
        "security": [
          {
            "lef_session": [],
            "x-csrf-token": []
          },
          {
            "oidc": []
          }
        ],
        "summary": "",
        "tags": [
          "Verification"
        ]
      }
    },
