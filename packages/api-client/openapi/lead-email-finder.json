    "/v1/email-verifications": {
      "post": {
        "description": "Admits one email for the authenticated organization through the durable admission stack. A fresh, uncached submission reserves one credit; a cached or shared result costs nothing. An optional canonical lowercase UUIDv7 Idempotency-Key header lets a caller safely retry an uncertain submission. Browser sessions require same-origin mutation protection.",
        "operationId": "AsyncEmailVerificationController_verifyAsync",
        "parameters": [
          {
            "description": "Required by the server and supplied automatically by browsers. Must exactly equal the configured application origin; Referer is not a fallback.",
            "in": "header",
            "name": "Origin",
            "required": false,
            "schema": {
              "format": "uri",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyAsyncRequestBodyDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyAsyncResponseDto"
                }
              }
            },
            "description": "The operation was admitted without waiting for verification. Follow Location to read status and result.",
            "headers": {
              "Location": {
                "description": "The admitted verification resource.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "error": "Bad Request",
                    "message": "invalid_idempotency_key",
                    "statusCode": 400
                  },
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        400
                      ],
                      "type": "integer"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The email is missing/invalid, or the Idempotency-Key header is malformed or repeated."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "code": "authentication_required"
                  },
                  "properties": {
                    "code": {
                      "enum": [
                        "authentication_required"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Authentication is required."
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "insufficient_credits",
                    "statusCode": 402
                  },
                  "properties": {
                    "message": {
                      "enum": [
                        "insufficient_credits"
                      ],
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        402
                      ],
                      "type": "integer"
                    }
                  },
                  "required": [
                    "statusCode",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The organization has insufficient credits; no execution was funded."
          },
          "403": {
            "description": "Email verification or exact application Origin is required."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "idempotency_key_conflict",
                    "statusCode": 409
                  },
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        409
                      ],
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The supplied Idempotency-Key was already used for a different address or delivery mode."
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "idempotency_key_expired",
                    "statusCode": 410
                  },
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        410
                      ],
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The supplied Idempotency-Key is more than 24 hours old."
          },
          "415": {
            "description": "Content-Type must be application/json."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "rate_limited",
                    "statusCode": 429
                  },
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "statusCode": {
                      "enum": [
                        429
                      ],
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The organization submission rate limit, or a per-address terminal-inconclusive cooldown, was exceeded."
          }
        },
        "security": [
          {
            "native_session": []
          }
        ],
        "summary": "",
        "tags": [
          "Verification"
        ]
      }
    },
    "/v1/email-verifications/{id}": {
      "get": {
        "description": "Reads an organization-owned operation without debit or submission. Missing, expired, and foreign operations are concealed with the same 404 response.",
        "operationId": "AsyncEmailVerificationController_getAsyncVerificationState",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "completed": {
                    "value": {
                      "operation": {
                        "billing": {
                          "charged": 1,
                          "reason": "conclusive",
                          "reserved": 1,
                          "state": "settled"
                        },
                        "cacheExpiresAt": "2026-09-14T00:00:00.000Z",
                        "id": "00000000-0000-4000-8000-000000000003",
                        "observedAt": "2026-09-13T00:00:00.000Z",
                        "source": "fresh"
                      },
                      "result": {
                        "catchAll": null,
                        "domain": "lef.test",
                        "email": "person@lef.test",
                        "exists": true,
                        "id": "00000000-0000-4000-8000-000000000002",
                        "localPart": "person",
                        "reason": "accepted_email",
                        "sources": [
                          "mx"
                        ]
                      },
                      "state": "completed"
                    }
                  },
                  "failed": {
                    "value": {
                      "failureCode": "verification_failed",
                      "operation": {
                        "billing": {
                          "charged": 0,
                          "reason": "inconclusive",
                          "reserved": 1,
                          "state": "settled"
                        },
                        "cacheExpiresAt": null,
                        "id": "00000000-0000-4000-8000-000000000003",
                        "observedAt": null,
                        "source": "fresh"
                      },
                      "state": "failed"
                    }
                  },
                  "queued": {
                    "value": {
                      "state": "queued"
                    }
                  },
                  "running": {
                    "value": {
                      "state": "running"
                    }
                  },
                  "unavailable": {
                    "value": {
                      "state": "unavailable"
                    }
