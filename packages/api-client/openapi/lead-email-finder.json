    "/v1/auth/sign-out": {
      "post": {
        "description": "Revokes the D1 session and expires its cookies. Requires the exact application Origin and application/json. Repeating sign-out without a current session succeeds.",
        "operationId": "signOut",
        "parameters": [
          {
            "description": "Required by the server and supplied automatically by browsers. Must exactly equal the configured application origin; Referer is not a fallback.",
            "in": "header",
            "name": "Origin",
            "required": false,
            "schema": {
              "format": "uri",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "success": {
                      "enum": [
                        true
                      ],
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The current session is revoked and cookies are expired.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents caching protected identity.",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Preserves session renewal or expiration cookies.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "invalid_request"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The JSON body must be an empty object."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "origin_not_allowed"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Origin is missing or does not exactly match the application origin."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "json_required"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Content-Type must be application/json."
          },
          "429": {
            "description": "The persistent authentication rate limit was exceeded."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "enum": [
                        "sign_out_failed"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Session revocation could not be confirmed; retry sign-out."
          }
        },
        "security": [],
        "summary": "Revoke the current browser session",
        "tags": [
          "Authentication"
        ]
      }
    },
