                            "status": {
                              "enum": [
                                "up",
                                "down"
                              ],
                              "type": "string"
                            }
                          },
                          "required": [
                            "status"
                          ],
                          "type": "object"
                        }
                      },
                      "required": [
                        "postgres"
                      ],
                      "type": "object"
                    },
                    "error": {
                      "properties": {
                        "postgres": {
                          "additionalProperties": true,
                          "properties": {
                            "status": {
                              "enum": [
                                "up",
                                "down"
                              ],
                              "type": "string"
                            }
                          },
                          "required": [
                            "status"
                          ],
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    "info": {
                      "properties": {
                        "postgres": {
                          "additionalProperties": true,
                          "properties": {
                            "status": {
                              "enum": [
                                "up",
                                "down"
                              ],
                              "type": "string"
                            }
                          },
                          "required": [
                            "status"
                          ],
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    "status": {
                      "enum": [
                        "ok",
