{
  "components": {
    "schemas": {
      "AsyncVerificationCompletedResponseDto": {
        "properties": {
          "operation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VerificationOperationMetadataDto"
              }
            ],
            "description": "Optional in the public contract so existing clients written before this field existed keep building —\n a real settled response always includes it."
          },
          "result": {
            "$ref": "#/components/schemas/AsyncVerificationResultDto"
          },
          "state": {
            "enum": [
              "completed"
            ],
            "type": "string"
          }
        },
        "required": [
          "state",
          "result"
        ],
        "type": "object"
      },
      "AsyncVerificationFailedResponseDto": {
        "properties": {
          "failureCode": {
            "enum": [
              "verification_failed"
            ],
            "type": "string"
          },
          "operation": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VerificationOperationMetadataDto"
              }
            ],
            "description": "Optional in the public contract so existing clients written before this field existed keep building —\n a real settled response always includes it."
          },
          "state": {
            "enum": [
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "state",
          "failureCode"
        ],
        "type": "object"
      },
      "AsyncVerificationQueuedResponseDto": {
        "properties": {
          "state": {
            "enum": [
              "queued"
            ],
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "AsyncVerificationResultDto": {
        "properties": {
          "catchAll": {
            "example": null,
            "nullable": true,
            "type": "boolean"
          },
          "domain": {
            "example": "lef.test",
            "type": "string"
          },
          "email": {
            "example": "person@lef.test",
            "format": "email",
            "type": "string"
          },
          "exists": {
            "example": true,
            "nullable": true,
            "type": "boolean"
          },
          "format": {
            "enum": [
              "{first}",
              "{last}",
              "{first}.{last}",
              "{f}{last}",
              "{f}.{last}",
              "{first}{last}",
              "{first}{l}",
              "{first}.{l}",
              "{last}.{first}",
              "{first}_{last}",
              "{last}{f}",
              "{f}{l}",
              "{l}{first}",
              "{l}.{first}",
              "{last}{first}",
              "{first}-{last}"
            ],
            "type": "string"
          },
          "id": {
            "example": "00000000-0000-4000-8000-000000000002",
            "format": "uuid",
            "type": "string"
          },
          "localPart": {
            "example": "person",
            "type": "string"
          },
          "mxDomain": {
            "example": "lef.test",
            "type": "string"
          },
          "reason": {
            "enum": [
              "accepted_email",
              "rejected_email",
              "timeout",
              "temporarily_blocked",
              "no_mx_records",
              "unexpected_error",
              "blacklisted",
              "no_connect",
              "exceeded_storage",
              "sender_blocked",
              "secure_transport_unavailable",
              "webmail",
              "unknown"
            ],
            "example": "accepted_email",
            "type": "string"
          },
          "sources": {
            "example": [
              "mx"
            ],
            "items": {
              "enum": [
                "mx",
                "microsoft_1",
                "microsoft_2",
                "microsoft_4",
                "mimecast",
                "linkedin"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "targetExchange": {
            "example": "mx.lef.test",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "localPart",
          "domain",
          "exists",
          "catchAll",
          "reason",
          "sources"
        ],
        "type": "object"
      },
      "AsyncVerificationRunningResponseDto": {
        "properties": {
          "state": {
            "enum": [
              "running"
            ],
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "AsyncVerificationUnavailableResponseDto": {
        "properties": {
          "state": {
            "enum": [
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "BillingSummaryResponseDto": {
        "properties": {
          "available": {
            "description": "Credits usable for new spending: balance minus reserved",
            "minimum": 0,
            "type": "integer"
          },
          "balance": {
            "description": "Total credits owned by the organization",
            "minimum": 0,
            "type": "integer"
          },
          "reserved": {
            "description": "Credits held by accepted operations, not yet charged",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "balance",
          "reserved",
          "available"
        ],
        "type": "object"
      },
      "CurrentUserResponseDto": {
        "additionalProperties": false,
        "properties": {
          "user": {
            "additionalProperties": false,
            "properties": {
              "email": {
                "format": "email",
                "type": "string"
              },
              "emailVerified": {
                "type": "boolean"
              },
              "id": {
                "type": "string"
              },
              "image": {
                "nullable": true,
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "emailVerified",
              "image"
            ],
            "type": "object"
          }
        },
        "required": [
          "user"
        ],
        "type": "object"
      },
      "VerificationOperationBillingDto": {
        "properties": {
          "charged": {
            "enum": [
              0,
              1
            ],
            "type": "number"
          },
          "reason": {
            "enum": [
              "conclusive",
              "cached",
              "shared",
              "inconclusive",
              "failed"
            ],
            "type": "string"
          },
          "reserved": {
            "enum": [
              0,
              1
            ],
            "type": "number"
          },
          "state": {
            "enum": [
              "pending",
              "settled"
            ],
            "type": "string"
          }
        },
        "required": [
          "state",
          "reserved",
          "charged"
        ],
        "type": "object"
      },
      "VerificationOperationMetadataDto": {
        "properties": {
          "billing": {
            "$ref": "#/components/schemas/VerificationOperationBillingDto"
          },
          "cacheExpiresAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "observedAt": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "source": {
            "enum": [
              "fresh",
              "cache",
              "shared"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "observedAt",
          "cacheExpiresAt",
          "billing"
        ],
        "type": "object"
      },
      "VerifyAsyncRequestBodyDto": {
        "properties": {
          "email": {
            "example": "person@lef.test",
            "format": "email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "VerifyAsyncResponseDto": {
        "properties": {
          "id": {
            "example": "00000000-0000-4000-8000-000000000001",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "native_session": {
        "description": "D1-backed HttpOnly, SameSite=Lax session. HTTPS uses __Secure-better-auth.session_token and Secure.",
        "in": "cookie",
        "name": "better-auth.session_token",
        "type": "apiKey"
      }
    }
  },
