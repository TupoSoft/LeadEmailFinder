### Legacy Verify Email
GET {{host}}/verify?email={{$random.email}}
Authorization: Bearer {{token}}
Content-Type: application/json

### Bad request
POST {{host}}/emails/verify
Authorization: Bearer {{token}}
Content-Type: application/json

> {%
    client.test('should be BAD REQUEST', () => {
        client.assert(response.status === 400)
    })
%}

### Email exists
POST {{host}}/emails/verify
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "kyrylo.kupixn@gmail.com"
}

> {%
    client.test('should be OK', () => {
        client.assert(response.status === 200)
        client.assert(response.body.exists === true)
        client.assert(response.body.sources.includes('mx'))
    })
%}

### Email exists, catch-all verification
POST {{host}}/emails/verify
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "kyrylo.kupin@outlook.com"
}

> {%
    client.test('should be OK', () => {
        client.assert(response.status === 200)
        client.assert(response.body.exists === true)
        client.assert(response.body.sources.includes('microsoft_2'))
    })
%}

### Verify a single email
POST {{host}}/emails/verify
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "{{$random.email}}"
}

> {%
    client.test('should be OK', () => {
        client.assert(response.status === 200)
    })
%}

### Verify multiple emails
POST {{host}}/emails/verify/bulk
Authorization: Bearer {{token}}
Content-Type: application/json

[
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}",
    "{{$random.email}}"
]

> {%
    const { monitorUrl } = response.body

    client.test('should be ACCEPTED', () => {
        client.assert(response.status === 202)
    })

    client.test('should have a URL to monitor the status', () => {
        client.assert(monitorUrl, 'There is no URL in the response body')
        client.global.set('monitorUrl', monitorUrl)
    })
%}

### Get status
GET {{monitorUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

> {%
    const { status } = response.body

    client.test('should be ACCEPTED', () => {
        client.assert(response.status === 200)
    })

    client.test('must have a status', () => {
        client.assert(status, 'There is no status in the response body')
    })
%}

### Get result
< {%
    const resultUrl = client.global.get('monitorUrl').replace('/status', '')
    request.variables.set('resultUrl', resultUrl)
%}

GET {{resultUrl}}
Authorization: Bearer {{token}}
Content-Type: application/json

> {%
    client.test('should be OK', () => {
        client.assert(response.status === 200)
    })
%}
