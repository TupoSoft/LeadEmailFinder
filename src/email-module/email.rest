### GET emails
GET {{host}}/emails
Authorization: Bearer {{token}}
Content-Type: application/json

### Add email
POST {{host}}/emails
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "john.dxdozxe@example.com",
  "format": "{first}.{last}",
  "exists": true
}

> {%
    client.test('OK', () => {
        client.assert(response.status === 201)
        client.global.set('emailId', response.body.email)
    })
%}

### Update email
PATCH {{host}}/emails/{{emailId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "exists": false
}

### Delete email
DELETE {{host}}/emails/{{emailId}}
Authorization: Bearer {{token}}
Content-Type: application/json

### Get by id
GET {{host}}/emails/{{emailId}}
Authorization: Bearer {{token}}
Content-Type: application/json

> {%
    client.test('DELETED', () => {
        client.assert(response.status === 404)
    })
%}

