@url={{ services.api.host }}:{{ services.api.port }}

### Verify
POST {{url}}/verify
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "kyrylo.kupin@gmail.com"
}

### Verify Async
POST {{url}}/verifyAsync
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "igor.mihajlov@tuposoft.com"
}

> {%
    client.test('should be ACCEPTED', () => {
        client.assert(response.status === 202, 'Status code is not 202')
        client.global.set('jobId', response.body.id)
    })
%}

### Get Async Verification Status
GET {{url}}/verifyAsync/{{jobId}}
Content-Type: application/json
Authorization: Bearer {{token}}

### Verify Batch
POST {{url}}/verifyBatch/csv
Content-Type: multipart/form-data; boundary=boundary
Authorization: Bearer {{token}}

--boundary
Content-Disposition: form-data; name="file"; filename="test.csv"
Content-Type: text/csv

email
john.doe@gmail.com
kyrylo.kupin@gmail.com
igor.mihajlov@gmail.com

--boundary--

> {%
    client.test('should be 202', () => {
        client.assert(response.status === 202, 'Status code is not 202')
        client.global.set('id', response.body.id)
    })
%}

### Get Verify Batch Status
GET {{url}}/verifyBatch/{{id}}
Authorization: Bearer {{token}}

### Get Verify Batch Results
GET {{url}}/verifyBatch/{{id}}/results
Authorization: Bearer {{token}}
