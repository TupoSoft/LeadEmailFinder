{
    "name": "@tuposoft/lead-email-finder-web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "lint": "eslint .",
        "typecheck": "tsc -b",
        "test": "vitest",
        "test:ci": "vitest run",
        "test:ui-audit": "node --test ../../scripts/frontend/audit-premium-ui.test.mjs",
        "build": "tsc -b && vite build",
        "design:lint": "design.md lint ../../DESIGN.md",
        "ui:audit": "node ../../scripts/frontend/audit-premium-ui.mjs --mode strict ../..",
        "preview": "vite preview",
        "test:e2e": "pnpm build && pnpm test:e2e:prebuilt",
        "test:e2e:prebuilt": "playwright test tests/e2e/public-entry.spec.ts tests/e2e/not-found.spec.ts tests/e2e/auth-shell.spec.ts tests/e2e/billing-ui.spec.ts tests/e2e/team-ui.spec.ts tests/e2e/verification-ui.spec.ts tests/e2e/batch-verification-ui.spec.ts tests/e2e/verification-billing-ui.spec.ts",
        "test:a11y": "pnpm build && pnpm test:a11y:prebuilt",
        "test:a11y:prebuilt": "playwright test tests/e2e/accessibility.spec.ts",
        "test:visual": "pnpm build && pnpm test:visual:prebuilt",
        "test:visual:prebuilt": "playwright test tests/e2e/visual.spec.ts",
        "test:gateway": "node ../../scripts/testing/web-live.mjs",
        "browser-fixtures:bootstrap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/support/bootstrap-browser-fixtures.ts",
        "test:privileged": "LEF_PLAYWRIGHT_SUITE=privileged playwright test",
        "test:invitations": "LEF_PLAYWRIGHT_SUITE=invitation playwright test",
        "test:verification-artifacts": "node --test ../../scripts/testing/verification-browser-artifacts.spec.mjs",
        "test:verification-live": "LEF_PLAYWRIGHT_SUITE=verification playwright test",
        "test:team-live": "LEF_PLAYWRIGHT_SUITE=team playwright test",
        "test:privileged-artifacts": "node --test ../../scripts/testing/browser-fixture-artifacts.spec.mjs",
        "test:invitation-artifacts": "node --test ../../scripts/testing/invitation-browser-artifacts.spec.mjs",
        "verify:ui": "pnpm build && playwright test",
        "test:service-clients": "LEF_PLAYWRIGHT_SUITE=service-clients playwright test",
        "test:service-clients-live": "LEF_PLAYWRIGHT_SUITE=service-clients-live playwright test",
        "test:service-client-artifacts": "node --test ../../scripts/testing/service-client-browser-artifacts.spec.mjs",
        "test:batch-verification-live": "LEF_PLAYWRIGHT_SUITE=batch-verification playwright test",
        "test:platform-organizations": "LEF_PLAYWRIGHT_SUITE=platform-organizations playwright test",
        "test:platform-organizations-live": "LEF_PLAYWRIGHT_SUITE=platform-organizations-live playwright test",
        "test:platform-proxies": "LEF_PLAYWRIGHT_SUITE=platform-proxies playwright test",
        "test:platform-proxies-live": "LEF_PLAYWRIGHT_SUITE=platform-proxies-live playwright test",
        "test:proxy-artifacts": "node --test ../../scripts/testing/proxy-browser-artifacts.spec.mjs",
        "test:platform-credits": "LEF_PLAYWRIGHT_SUITE=platform-credits playwright test",
        "test:platform-credits-live": "LEF_PLAYWRIGHT_SUITE=platform-credits-live playwright test"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "@tanstack/react-query": "^5.102.8",
        "@tuposoft/lead-email-finder-api-client": "workspace:*",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.0",
        "@eslint/js": "^9.34.0",
        "@google/design.md": "0.4.0",
        "@playwright/test": "^1.50.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.0",
        "@types/node": "^22.18.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react-swc": "^4.0.0",
        "eslint": "^9.34.0",
        "eslint-plugin-react-hooks": "^6.0.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.3.0",
        "jsdom": "^27.0.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.41.0",
        "vite": "^8.0.0",
        "vitest": "^4.0.0"
    }
}
