{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "builder": {
            "type": "swc",
            "options": {
                "stripLeadingPaths": true,
                "ignore": ["src/libs/common/src/testing/**"]
            }
        },
        "typeCheck": true,
        "plugins": [
            {
                "name": "@nestjs/swagger",
                "options": { "introspectComments": true, "esmCompatible": true }
            }
        ]
    }
}
