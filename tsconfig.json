      "@tuposoft/lead-email-finder/key/*": [
        "libs/key/src/*"
      ],
      "@tuposoft/lead-email-finder/proto": [
        "libs/proto/src"
      ],
      "@tuposoft/lead-email-finder/proto/*": [
        "libs/proto/src/*"
      ],
      "@tuposoft/lead-email-finder/redis": [
        "libs/redis/src"
      ],
      "@tuposoft/lead-email-finder/redis/*": [
        "libs/redis/src/*"
      ],
      "@tuposoft/lead-email-finder/socket": [
        "libs/socket/src"
      ],
      "@tuposoft/lead-email-finder/socket/*": [
        "libs/socket/src/*"
      ]
    }
  }
}
