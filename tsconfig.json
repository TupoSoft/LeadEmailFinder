{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "declaration": true,
        "noImplicitAny": true,
        "useUnknownInCatchVariables": true,
        "removeComments": true
    },
    "include": ["src", "__mocks__"],
    "exclude": ["node_modules", "dist"]
}
