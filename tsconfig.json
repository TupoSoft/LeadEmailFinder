{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/**/*.ts"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@tuposoft/lead-email-finder/catch-all": [
        "libs/catch-all/src"
      ],
      "@tuposoft/lead-email-finder/catch-all/*": [
        "libs/catch-all/src/*"
      ],
      "@tuposoft/lead-email-finder/common": [
        "libs/common/src"
      ],
      "@tuposoft/lead-email-finder/common/*": [
        "libs/common/src/*"
      ],
      "@tuposoft/lead-email-finder/config": [
        "libs/config/src"
      ],
      "@tuposoft/lead-email-finder/config/*": [
        "libs/config/src/*"
      ],
      "@tuposoft/lead-email-finder/dns": [
        "libs/dns/src"
      ],
      "@tuposoft/lead-email-finder/dns/*": [
        "libs/dns/src/*"
      ],
      "@tuposoft/lead-email-finder/grpc": [
        "libs/grpc/src"
      ],
      "@tuposoft/lead-email-finder/grpc/*": [
        "libs/grpc/src/*"
      ],
      "@tuposoft/lead-email-finder/key": [
        "libs/key/src"
