{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/**/*.ts"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@tuposoft/lead-email-finder/dns": [
        "libs/dns/src"
      ],
      "@tuposoft/lead-email-finder/dns/*": [
        "libs/dns/src/*"
      ],
      "@tuposoft/lead-email-finder/key": [
        "libs/key/src"
      ],
      "@tuposoft/lead-email-finder/key/*": [
        "libs/key/src/*"
      ],
      "@tuposoft/lead-email-finder/redis": [
        "libs/redis/src"
      ],
      "@tuposoft/lead-email-finder/redis/*": [
        "libs/redis/src/*"
      ],
      "@tuposoft/lead-email-finder/socket": [
        "libs/socket/src"
      ],
      "@tuposoft/lead-email-finder/socket/*": [
        "libs/socket/src/*"
      ]
    }
  }
}