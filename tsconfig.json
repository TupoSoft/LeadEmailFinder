{
    "extends": "./tsconfig.base.json",
    "ts-node": {
        "require": ["tsconfig-paths/register"]
    },
    "include": ["src/**/*.ts", "scripts/**/*.ts", "jest.config.ts"],
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@tuposoft/lead-email-finder/catch-all": ["src/libs/catch-all/src"],
            "@tuposoft/lead-email-finder/catch-all/*": ["src/libs/catch-all/src/*"],
            "@tuposoft/lead-email-finder/common": ["src/libs/common/src"],
            "@tuposoft/lead-email-finder/common/*": ["src/libs/common/src/*"],
            "@tuposoft/lead-email-finder/config": ["src/libs/config/src"],
            "@tuposoft/lead-email-finder/config/*": ["src/libs/config/src/*"],
            "@tuposoft/lead-email-finder/dns": ["src/libs/dns/src"],
            "@tuposoft/lead-email-finder/dns/*": ["src/libs/dns/src/*"],
            "@tuposoft/lead-email-finder/key": ["src/libs/key/src"],
            "@tuposoft/lead-email-finder/key/*": ["src/libs/key/src/*"],
            "@tuposoft/lead-email-finder/redis": ["src/libs/redis/src"],
            "@tuposoft/lead-email-finder/redis/*": ["src/libs/redis/src/*"],
            "@tuposoft/lead-email-finder/socket": ["src/libs/socket/src"],
            "@tuposoft/lead-email-finder/socket/*": ["src/libs/socket/src/*"],
            "@tuposoft/lead-email-finder/modules/auth": ["src/libs/modules/auth/src"],
            "@tuposoft/lead-email-finder/modules/auth/*": ["src/libs/modules/auth/src/*"],
            "@tuposoft/lead-email-finder/modules/bff-session": ["src/libs/modules/bff-session/src"],
            "@tuposoft/lead-email-finder/modules/bff-session/*": ["src/libs/modules/bff-session/src/*"],
            "@tuposoft/lead-email-finder/modules/credits": ["src/libs/modules/credits/src"],
            "@tuposoft/lead-email-finder/modules/credits/*": ["src/libs/modules/credits/src/*"],
            "@tuposoft/lead-email-finder/modules/identity": ["src/libs/modules/identity/src"],
            "@tuposoft/lead-email-finder/modules/identity/*": ["src/libs/modules/identity/src/*"],
            "@tuposoft/lead-email-finder/modules/payments": ["src/libs/modules/payments/src"],
            "@tuposoft/lead-email-finder/modules/payments/*": ["src/libs/modules/payments/src/*"],
            "@tuposoft/lead-email-finder/modules/proxy": ["src/libs/modules/proxy/src"],
            "@tuposoft/lead-email-finder/modules/proxy/*": ["src/libs/modules/proxy/src/*"]
        }
    }
}
