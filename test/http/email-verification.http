### Verify a single email
POST http://localhost:3000/api/v0/email/verify
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "email": "kyrylo.kupin@gmail.com"
}

### Verify multiple emails
POST http://localhost:3000/api/v0/email/verify/bulk
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "emails": [
    "kyrylo.kupin@gmail.com",
    "jdoe@gmail.com",
    "doe@gmail.com"
  ]
}

### Find lead
POST http://localhost:3000/api/v0/lead/find
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "firstName": "john",
  "lastName": "doe",
  "domain": "gmail.com"
}

### Find leads
POST http://localhost:3000/api/v0/lead/find/bulk
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "leads": [
    {
      "firstName": "john",
      "lastName": "doe",
      "domain": "gmail.com"
    },
    {
      "firstName": "jane",
      "lastName": "doe",
      "domain": "gmail.com"
    }
  ]
}

