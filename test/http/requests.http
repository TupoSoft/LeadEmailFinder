### Verify a single email
GET http://localhost:3000/verify?email=john.doe
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Accept: application/json

### Verify multiple emails
POST http://localhost:3000/verify
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "emails": [
    "kyrylo.kupin@gmail.com",
    "kkupin@gmail.com",
    "kupin@gmail.com"
  ]
}

### Find lead
POST http://localhost:3000/findLead
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "firstName": "andrii",
  "lastName": "kolpakov",
  "domain": "generect.com"
}

### Post a domain
POST http://localhost:3000/domain
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "name": "tuposoft.com",
  "catchAllEnabled": false
}

