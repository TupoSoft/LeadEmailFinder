### Verify a single email
POST http://localhost:3000/verifyEmail
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "email": "kyrylo@gmail.com"
}

### Verify multiple emails
POST http://localhost:3000/verifyEmails
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "emails": [
    "kyrylo.kupin@gmail.com",
    "kkupin@gmail.com",
    "kupin@gmail.com"
  ]
}

### Find lead
POST http://localhost:3000/findLead
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "firstName": "kyrylo",
  "lastName": "kupin",
  "domain": "gmail.com"
}

### Find leads
POST http://localhost:3000/findLeads
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "leads": [
    {
      "firstName": "john",
      "lastName": "doe",
      "domain": "gmail.com"
    },
    {
      "firstName": "jane",
      "lastName": "doe",
      "domain": "gmail.com"
    }
  ]
}

### Post a domain
POST http://localhost:3000/domain
Authorization: Bearer ce67e59812a338b997e35da8328df720c255ae5b3ad726d7117bc2508acf3bf9
Content-Type: application/json

{
  "name": "gmail.com",
  "catchAllEnabled": false
}

