@host = localhost:3000

### Registration
POST {{host}}/api/v0/auth/register
Content-Type: application/json

{
  "email": "{{$random.email}}",
  "password": "{{$random.internet.password}}"
}

> {%
    client.test('Success', () => {
        client.assert(response.status === 201, 'Response status is not 201')
    })
%}
