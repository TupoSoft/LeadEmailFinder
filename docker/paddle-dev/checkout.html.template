<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <title>LeadEmailFinder Paddle sandbox checkout</title>
        <script src="https://cdn.paddle.com/paddle/v2/paddle.js" defer></script>
        <style>
            :root {
                color-scheme: light;
                font-family: system-ui, sans-serif;
            }

            body {
                display: grid;
                min-height: 100vh;
                margin: 0;
                place-items: center;
                background: #f5f7fb;
                color: #172033;
            }

            main {
                width: min(36rem, calc(100% - 3rem));
                padding: 2rem;
                border: 1px solid #dce2ee;
                border-radius: 1rem;
                background: white;
                box-shadow: 0 1rem 3rem rgb(23 32 51 / 8%);
            }

            code {
                padding: 0.125rem 0.375rem;
                border-radius: 0.25rem;
                background: #eef2f8;
            }
        </style>
    </head>
    <body>
        <main>
            <h1>Paddle sandbox checkout</h1>
            <p>The transaction checkout opens automatically when this page includes Paddle's <code>_ptxn</code> parameter.</p>
            <p>If no overlay appears, start a fresh credit purchase and open the checkout URL returned by the API.</p>
        </main>
        <script>
            window.addEventListener('DOMContentLoaded', () => {
                Paddle.Environment.set('sandbox')
                Paddle.Initialize({
                    token: '${PADDLE_CLIENT_TOKEN}',
                    checkout: {
                        settings: {
                            displayMode: 'overlay',
                            theme: 'light',
                            locale: 'en',
                        },
                    },
                })
            })
        </script>
    </body>
</html>
